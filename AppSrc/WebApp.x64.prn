37694>>>    Procedure SetActionButtons
37697>>>        tWebNavigateData NavigateData
37697>>>        tWebNavigateData NavigateData
37697>>>        Boolean bHasRecord
37697>>>        Handle hoDD
37697>>>
37697>>>        Get Server to hoDD
37698>>>        Get GetNavigateData to NavigateData
37699>>>        Get HasRecord of hoDD to bHasRecord
37700>>>
37700>>>        // let's hide all buttons and then Show the ones we want
37700>>>        WebSet pbRender of oEditBtn to False
37701>>>        WebSet pbRender of oSaveBtn to False
37702>>>        WebSet pbRender of oCancelChangesBtn to False
37703>>>        WebSet pbRender of oDeleteBtn to False
37704>>>
37704>>>        If (NavigateData.bReadOnly) Begin
37706>>>            WebSet pbRender of oEditBtn to True
37707>>>        End
37707>>>>
37707>>>        Else Begin
37708>>>            WebSet pbRender of oSaveBtn to True
37709>>>            WebSet pbRender of oCancelChangesBtn to True
37710>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37711>>>        End
37711>>>>
37711>>>    End_Procedure
37712>>>
