38700>>>                // If from parent, this is a constrained drill down
38700>>>                // If Row select does main-zoom we don't need this
38700>>>                WebSet pbRender of oDetailButton to False
38701>>>                Case Break
38702>>>
38702>>>            Case (NavigateData.eNavigateType = nfFromChild)
38705>>>                // If from child, this is a probably a parent lookup from a Zoom
38705>>>                Case Break
38706>>>
38706>>>            Case (NavigateData.eNavigateType = nfFromMain)
38709>>>                // If from main, this is a probably a main-file lookup from a Zoom
38709>>>                WebSet pbRender of oDetailButton to False
38710>>>                Case Break
38711>>>
38711>>>            Case Else // must be nfUndefined
38711>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38711>>>                // If Row select does main-zoom we don't need this
38711>>>                WebSet pbRender of oDetailButton to False
38712>>>
38712>>>        Case End
38712>>>
38712>>>    End_Procedure
